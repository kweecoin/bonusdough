function money(n){
  // if payoutLabel exists, we use that
  return n;
}

function render(){
  const q = (search.value || "").trim().toLowerCase();
  const c = country.value;
  const e = effort.value;
  const s = sort.value;

  let items = OFFERS.filter(o => {
    const matchesQ =
      !q ||
      o.brand.toLowerCase().includes(q) ||
      o.requirements.toLowerCase().includes(q) ||
      (o.payoutLabel || "").toLowerCase().includes(q);

    const matchesC = !c || o.country === c;
    const matchesE = !e || o.effort === e;

    return matchesQ && matchesC && matchesE;
  });

  if (s === "payoutDesc"){
    items.sort((a,b) => (b.payout||0) - (a.payout||0));
  } else if (s === "endingSoon"){
    items.sort((a,b) => (a.endsInDays||9999) - (b.endsInDays||9999));
  }

  grid.innerHTML = "";
  empty.hidden = items.length !== 0;

  for (const o of items){
    const card = document.createElement("div");
    card.className = "card";
    card.innerHTML = `
      <div class="shine" aria-hidden="true"></div>
      <div class="cardInner">
        <div class="row">
          <div>
            <div class="name">${escapeHtml(o.brand)}</div>
            <div class="small">${escapeHtml(o.requirements)}</div>
          </div>
          <div class="pill">${escapeHtml(o.effort)}</div>
        </div>

        <div class="payout">${escapeHtml(o.payoutLabel || "$" + o.payout)}</div>

        <div class="pills">
          <div class="pill">🌍 ${escapeHtml(o.country)}</div>
          <div class="pill">⏱️ ${escapeHtml(String(o.endsInDays))} days left</div>
          <div class="pill">🧾 ${escapeHtml(o.requirements)}</div>
        </div>

        <div class="actions">
          <button class="btn holo" data-open="${o.id}"><span>View</span></button>
          <button class="btn" data-copy="${o.id}">Copy link</button>
        </div>
      </div>
    `;

    // Buttons
    card.querySelector(`[data-open="${o.id}"]`).addEventListener("click", () => openOffer(o.id));
    card.querySelector(`[data-copy="${o.id}"]`).addEventListener("click", () => copyText(o.link));

    // Tap card also opens
    card.addEventListener("dblclick", () => openOffer(o.id));

    // 3D tilt for desktop only (safe on mobile)
    card.addEventListener("mousemove", (evt) => tiltCard(card, evt));
    card.addEventListener("mouseleave", () => resetTilt(card));

    grid.appendChild(card);
  }
}

function openOffer(id){
  const o = OFFERS.find(x => x.id === id);
  if (!o) return;

  mTitle.textContent = o.brand;
  mMeta.textContent = `${o.country} • ${o.effort} • ${o.endsInDays} days left`;
  mPayout.textContent = o.payoutLabel || ("$" + o.payout);

  mPills.innerHTML = `
    <div class="pill">🌍 ${escapeHtml(o.country)}</div>
    <div class="pill">⏱️ ${escapeHtml(String(o.endsInDays))} days left</div>
    <div class="pill">🧾 ${escapeHtml(o.requirements)}</div>
  `;

  mSteps.innerHTML = "";
  (o.steps || []).forEach(step => {
    const li = document.createElement("li");
    li.textContent = step;
    mSteps.appendChild(li);
  });

  mLink.value = o.link || "";
  mNote.textContent = o.note || "";

  if (typeof modal.showModal === "function") modal.showModal();
  else modal.setAttribute("open", "true");
}

function closeOffer(){
  if (typeof modal.close === "function") modal.close();
  else modal.removeAttribute("open");
}

closeModalBtn.addEventListener("click", closeOffer);
modal.addEventListener("click", (e) => {
  // click outside the frame closes
  const rect = modal.getBoundingClientRect();
  const inDialog = (
    e.clientX >= rect.left && e.clientX <= rect.right &&
    e.clientY >= rect.top && e.clientY <= rect.bottom
  );
  if (!inDialog) closeOffer();
});

copyBtn.addEventListener("click", () => copyText(mLink.value));

async function copyText(text){
  try{
    await navigator.clipboard.writeText(text);
    toast("Copied!");
  }catch{
    // fallback
    const t = document.createElement("textarea");
    t.value = text;
    document.body.appendChild(t);
    t.select();
    document.execCommand("copy");
    document.body.removeChild(t);
    toast("Copied!");
  }
}

let toastTimer;
function toast(msg){
  clearTimeout(toastTimer);
  let t = document.getElementById("toast");
  if (!t){
    t = document.createElement("div");
    t.id = "toast";
    t.style.position = "fixed";
    t.style.left = "50%";
    t.style.bottom = "18px";
    t.style.transform = "translateX(-50%)";
    t.style.padding = "10px 12px";
    t.style.borderRadius = "14px";
    t.style.border = "1px solid rgba(255,255,255,.14)";
    t.style.background = "rgba(7,7,16,.82)";
    t.style.backdropFilter = "blur(12px)";
    t.style.color = "rgba(255,255,255,.9)";
    t.style.fontWeight = "700";
    t.style.fontSize = "13px";
    t.style.zIndex = "9999";
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = "1";
  toastTimer = setTimeout(() => { t.style.opacity = "0"; }, 1100);
}

// Tilt (desktop flavor)
function tiltCard(card, evt){
  // Skip on touch devices
  if (window.matchMedia("(pointer: coarse)").matches) return;

  const r = card.getBoundingClientRect();
  const px = (evt.clientX - r.left) / r.width;
  const py = (evt.clientY - r.top) / r.height;

  const rotY = (px - 0.5) * 10;
  const rotX = -(py - 0.5) * 10;

  card.style.transform = `translateY(-2px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
}
function resetTilt(card){
  card.style.transform = "";
}

function escapeHtml(str){
  return String(str)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

