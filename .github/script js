// ---------- UI ----------
const el = (id) => document.getElementById(id);

const grid = el("grid");
const empty = el("empty");

const search = el("search");
const country = el("country");
const effort = el("effort");
const sort = el("sort");

const submitBtn = el("submitBtn");
